# LiveKit project: https://cloud.livekit.io
# The agent's speech and language models run on LiveKit Inference, so these are the only AI keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# From the SIP URI on your LiveKit project settings page: sip:<this value>.sip.livekit.cloud
# It can differ from the subdomain in LIVEKIT_URL.
LIVEKIT_SIP_SUBDOMAIN=your_sip_subdomain

# The Vobiz number callers dial, in E.164 format.
VOBIZ_INBOUND_NUMBER=+91XXXXXXXXXX
